files:
  "/etc/cron.d/moodle":
    mode: "000644"
    owner: root
    group: root
    content: |
      * * * * * root bash -c 'set -a; [ -f /opt/elasticbeanstalk/deployment/env ] && source /opt/elasticbeanstalk/deployment/env; set +a; sudo -E -u webapp /usr/bin/php /var/app/current/admin/cli/cron.php' > /dev/null 2>&1
