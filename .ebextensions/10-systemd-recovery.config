files:
  "/etc/systemd/system/nginx.service.d/override.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Service]
      Restart=always
      RestartSec=5s

  "/etc/systemd/system/php-fpm.service.d/override.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Service]
      Restart=always
      RestartSec=5s

commands:
  01_reload_systemd:
    command: "systemctl daemon-reload"
